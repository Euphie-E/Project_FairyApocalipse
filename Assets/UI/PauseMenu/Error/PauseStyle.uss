:root {
    font-size: 45px;
}

.unity-tab-view
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(224, 255, 215);
}

.unity-tab-view_header-container
{
   height: 60px;
}

.unity-tab-view_content-container
{
    flex-grow: 1;
    padding: 5px;
    flex-basis: 80%;
    align-items: center;
}

.unity-tab_header
{
    background-color: cyan;
}

.unity-tab
{
    padding: 10px;
    width: 100%;
    height: 100%; 
    flex-grow: 1;
}

.unity-tab_content-container
{
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    align-items: center;
}




