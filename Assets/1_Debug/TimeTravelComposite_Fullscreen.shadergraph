{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "bcb60126df2849098d4f7ef61aed19c8",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SurfaceInsideSphere (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1607.0,
            "y": -174.00013732910157,
            "width": 273.0,
            "height": 166.00013732910157
        }
    },
    "m_Slots": [
        {
            "m_Id": "05fd66f1e6ad4a98919c8b1fa9bce874"
        },
        {
            "m_Id": "0332b96368af4bb2be8629246b94b0e0"
        },
        {
            "m_Id": "9f2c715c95064058a8193fa6db286691"
        },
        {
            "m_Id": "348a94522dc046809d244e89fee3e3ef"
        },
        {
            "m_Id": "bc110efa74974a2d973c870617ca7c42"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SurfaceInsideSphere",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float depth = RawDepth;\r\n\r\n#if !UNITY_REVERSED_Z\r\n    depth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, RawDepth);\r\n#endif\r\n\r\nfloat3 worldPosition = ComputeWorldSpacePosition(\r\n    UV,\r\n    depth,\r\n    UNITY_MATRIX_I_VP\r\n);\r\n\r\nfloat distanceToCenter = distance(\r\n    worldPosition,\r\n    SphereCenter\r\n);\r\n\r\nMask = distanceToCenter <= SphereRadius ? 1.0 : 0.0;"
}

