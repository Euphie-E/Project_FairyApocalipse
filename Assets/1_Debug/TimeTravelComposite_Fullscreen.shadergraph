{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3a220ae1edd84bb58be63cf83513f0ff",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SphereMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1051.0,
            "y": 47.99998092651367,
            "width": 225.0,
            "height": 142.0000762939453
        }
    },
    "m_Slots": [
        {
            "m_Id": "8b5c25043c2f43ef8a0a1626d4e64f69"
        },
        {
            "m_Id": "b52da2a7c73f4a9ba7294f6fb63087a2"
        },
        {
            "m_Id": "b68d1fa16f0947faae6ce959e55114db"
        },
        {
            "m_Id": "23e7435425f5464ca689df953a239b95"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SphereMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 ndc = UV * 2.0 - 1.0;\r\n\r\nfloat4 clipPos = float4(ndc, 1.0, 1.0);\r\n\r\nfloat4 worldPos = mul(UNITY_MATRIX_I_VP, clipPos);\r\nworldPos.xyz /= worldPos.w;\r\n\r\nfloat3 rayOrigin = _WorldSpaceCameraPos;\r\nfloat3 rayDirection = normalize(worldPos.xyz - rayOrigin);\r\n\r\nfloat3 originToSphere = rayOrigin - SphereCenter;\r\n\r\nfloat b = dot(originToSphere, rayDirection);\r\nfloat c = dot(originToSphere, originToSphere)\r\n        - SphereRadius * SphereRadius;\r\n\r\nfloat discriminant = b * b - c;\r\n\r\nMask = step(0.0, discriminant);"
}

